// Conventions: singular PascalCase model, plural snake_case table (@@map),
// camelCase fields with multi-word names mapped to snake_case columns (@map).
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  age       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
