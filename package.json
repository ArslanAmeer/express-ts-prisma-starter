{
	"name": "express-ts-prisma-starter",
	"version": "1.0.0",
	"description": "REST API starter: Express 5, TypeScript, Prisma and PostgreSQL",
	"author": "Arslan Ameer",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ArslanAmeer/express-ts-prisma-starter.git"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"build": "prisma generate && tsc --noEmit && tsdown",
		"start:dev": "node --import=tsx --watch src/index.ts",
		"start:prod": "node dist/index.js",
		"check": "biome check --write",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"postinstall": "prisma generate",
		"db:up": "node scripts/db-up.mjs",
		"db:down": "docker compose down",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:reset": "prisma migrate reset",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "9.1.0",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"cors": "2.8.6",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"express-rate-limit": "8.7.0",
		"helmet": "8.3.0",
		"http-status-codes": "2.3.0",
		"pg": "8.23.0",
		"pino": "10.3.1",
		"pino-http": "11.0.0",
		"swagger-ui-express": "5.0.1",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/pg": "8.23.1",
		"@types/supertest": "7.2.1",
		"@types/swagger-ui-express": "4.1.8",
		"@vitest/coverage-v8": "5.0.0",
		"pino-pretty": "13.1.3",
		"prisma": "7.10.0",
		"supertest": "7.2.2",
		"tsdown": "0.23.0",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vite": "7.3.5",
		"vitest": "5.0.0"
	},
	"tsdown": {
		"entry": [
			"src/index.ts"
		],
		"outDir": "dist",
		"format": [
			"esm"
		],
		"target": "es2020",
		"sourcemap": true,
		"clean": true,
		"dts": false,
		"fixedExtension": false,
		"deps": {
			"neverBundle": true
		}
	},
	"packageManager": "pnpm@10.33.0"
}
